# Copia este archivo a .env y completa los valores. Nunca subas .env al repo.

# --- Clerk (https://dashboard.clerk.com → API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhook de sincronización (Clerk → Webhooks → Signing Secret)
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook de pagos (stripe listen --forward-to localhost:3000/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=

# --- Neon Postgres (https://console.neon.tech → Connection string) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
