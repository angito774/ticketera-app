# Copia este archivo a .env y completa los valores. Nunca subas .env al repo.

# --- Clerk (https://dashboard.clerk.com â API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhook de sincronizaciÃ³n (Clerk â Webhooks â Signing Secret)
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook de pagos (stripe listen --forward-to localhost:3000/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=
# Webhook de cuentas conectadas (stripe listen --forward-to localhost:3000/api/webhooks/stripe/connect)
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Neon Postgres (https://console.neon.tech â Connection string) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Roles ---
# Correo (verificado en Clerk) que recibe el rol super admin al iniciar sesiÃ³n.
SUPER_ADMIN_EMAIL=nelson.nc421@gmail.com

# --- App ---
# URL pÃºblica base (success_url / cancel_url de Stripe Checkout)
APP_URL=http://localhost:3000

# --- Liquidación a organizadores (valores de demo, sin default en código) ---
# Comisión de la plataforma en puntos básicos (1000 = 10%) y monto fijo en centavos
PLATFORM_FEE_BPS=1000
PLATFORM_FEE_FIXED_CENTS=0
# Horas de espera tras events.starts_at antes de poder liquidar
SETTLEMENT_DELAY_HOURS=0
